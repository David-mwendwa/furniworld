# API base. The backend pins itself to 5005 (5000 is taken by macOS AirPlay).
VITE_API_URL=http://localhost:5005/api/v1

# Origin serving product images from the backend's public folder.
VITE_ASSET_URL=http://localhost:5005

# The public origin of the deployed site. Every canonical, the OG tags and the
# sitemap are built from it, so a custom domain has to be set here as well as at
# the DNS — left unset the build falls back to the Netlify subdomain and the
# canonicals will point away from the domain the pages are actually served on.
VITE_SITE_URL=https://furniworld.netlify.app
