NODE_ENV=development
PORT=5005

# Local Docker Mongo from infra/docker-compose.yml, or an Atlas connection string
DATABASE_URL=mongodb://localhost:27017/furniworld

# Origins allowed by CORS. The dev port is pinned in frontend/vite.config.js.
FRONTEND_URL=http://localhost:5006
PROD_FRONTEND_URL=https://furniworld.netlify.app

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Leave blank in development — password reset emails are logged to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Furniworld
SMTP_FROM_EMAIL=no-reply@furniworld.ke

# --- Payments ---
# Stripe test keys from dashboard.stripe.com (test mode). Leave blank and the
# checkout disables card with "Not configured in this demo".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Safaricom Daraja sandbox credentials (developer.safaricom.co.ke).
# Leave blank and the checkout disables M-Pesa the same way.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL Safaricom posts the STK result to. Daraja rejects the request
# outright if this isn't a syntactically valid https URL, so in dev it needs a
# placeholder (an ngrok tunnel, even an unreachable one) — a bare localhost URL
# gets "Invalid CallBackURL" before the push is even sent. The flag below is what
# actually settles the order in dev, since the callback itself can never arrive.
MPESA_CALLBACK_URL=
# The Daraja sandbox app has no test MSISDN that can approve an STK push, so a
# real push always returns a failure. This marks the order paid locally so the
# flow can be demonstrated end to end. Never true in production.
MPESA_SIMULATE_CALLBACK=true

API_URL=http://localhost:5005/api/v1
